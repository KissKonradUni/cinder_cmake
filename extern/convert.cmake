if(NOT ARGC EQUAL 4)
    message(FATAL_ERROR "Usage: cmake -P convert.cmake <spirv_file> <output_header> <var_name>")
    message(FATAL_ERROR "Provieded: ${CMAKE_ARGC} arguments.")
endif()

set(spirv_file ${CMAKE_ARGV1})
set(output_header ${CMAKE_ARGV2})
set(var_name ${CMAKE_ARGV3})

file(READ ${spirv_file} BINARY_DATA HEX)
string(REPLACE " " "" BINARY_DATA ${BINARY_DATA})
string(REPLACE "\n" "" BINARY_DATA ${BINARY_DATA})
set(HEADER_CONTENT "unsigned char ${var_name}[] = {")
string(LENGTH ${BINARY_DATA} DATA_LENGTH)
math(EXPR BYTE_COUNT "${DATA_LENGTH} / 2")
foreach(i RANGE 0 ${BYTE_COUNT} 16)
    math(EXPR end "${i} + 15")
    if(${end} GREATER ${BYTE_COUNT})
        math(EXPR end "${BYTE_COUNT} - 1")
    endif()
    string(SUBSTRING ${BINARY_DATA} ${i*2} 32 BYTE_CHUNK)
    if(BYTE_CHUNK STREQUAL "")
        break()
    endif()
    string(REGEX REPLACE "([0-9A-Fa-f]{2})" "0x\\1, " FORMATTED_CHUNK ${BYTE_CHUNK})
    set(HEADER_CONTENT "${HEADER_CONTENT}\n    ${FORMATTED_CHUNK}")
endforeach()
set(HEADER_CONTENT "${HEADER_CONTENT}\n};\nunsigned int ${var_name}_len = ${BYTE_COUNT};")
file(WRITE ${output_header} "${HEADER_CONTENT}")